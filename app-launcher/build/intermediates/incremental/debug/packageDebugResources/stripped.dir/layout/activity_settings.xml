<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ Dock Configuration"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_settings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕ Close"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Configure icon dimensions, text accent, graphic colors, and telemetry threshold alerts."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Icon Size Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Tile Icon Size Configuration"
                    android:textColor="@color/cyan_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_icon_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Current Icon Size: 56dp (Default 2x Large)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_28"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="28dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_40"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="40dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_56"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="56dp (2x)"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_72"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="72dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Frosted Glass Tint Accent Color -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎨 Tile Background Tint"
                    android:textColor="@color/amber_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_accent_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Current Tint: ❄️ Frosted Ice (#FFFFFF)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_color_ice"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❄️ Ice"
                        android:textSize="9sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_color_cyan"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="💎 Cyan"
                        android:textSize="9sp"
                        android:textColor="#00E5FF"
                        app:strokeColor="#00E5FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_color_violet"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="💜 Violet"
                        android:textSize="9sp"
                        android:textColor="#AB47BC"
                        app:strokeColor="#AB47BC" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_color_amber"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🧡 Amber"
                        android:textSize="9sp"
                        android:textColor="#FFAB00"
                        app:strokeColor="#FFAB00" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 3: Text Accent & Graphic Palette -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️ Text Accent &amp; Graphic Palette"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_cyber"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Cyber"
                        android:textSize="9sp"
                        android:textColor="#00E5FF"
                        app:strokeColor="#00E5FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_matrix"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🟢 Matrix"
                        android:textSize="9sp"
                        android:textColor="#00E676"
                        app:strokeColor="#00E676" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_sunset"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🌅 Sunset"
                        android:textSize="9sp"
                        android:textColor="#FF9100"
                        app:strokeColor="#FF9100" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 4: Reset Defaults -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Reset Dock Defaults"
                android:textColor="#FFFFFF"
                app:backgroundTint="#44768396"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
