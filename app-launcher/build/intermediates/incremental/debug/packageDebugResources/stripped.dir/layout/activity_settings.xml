<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Settings Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_dock_rail"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← "
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ DOCK &amp; LAUNCHER SETTINGS"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Icon Size Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Tile Icon Size Configuration"
                    android:textColor="@color/cyan_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_icon_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Current Icon Size: 56dp (Default 2x Large)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_28"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="28dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_40"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="40dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_56"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="56dp (2x)"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_72"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="72dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Dock Operations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dock Gestures &amp; Long-Press Actions"
                    android:textColor="@color/amber_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Tap Dock Icon: Opens Settings\n• Long-Press Dock Icon: Prompts to add DockApp or Launcher\n• Long-Press Tile: Context Actions (Edit, Move, Copy, Remove)\n• Configurable Icon Size: Definable in Settings (Default 56dp)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Section 3: Reset Defaults -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Reset Dock Defaults"
                android:textColor="#FFFFFF"
                app:backgroundTint="#44768396"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
