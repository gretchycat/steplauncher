<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <!-- PER-WORKSPACE ANDROID APPWIDGET CANVAS (Background Layer between docks) -->
    <FrameLayout
        android:id="@+id/fl_workspace_widget_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dock_bottom_container"
        app:layout_constraintStart_toEndOf="@id/dock_bottom_left_container"
        app:layout_constraintEnd_toStartOf="@id/dock_top_right_container" />

    <!-- MAIN DOCK (TOP RIGHT - Anchored flush to top-right edge) -->
    <LinearLayout
        android:id="@+id/dock_top_right_container"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_glass_dock_rail"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dock_top_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dock_tile" />
    </LinearLayout>

    <!-- RUNNING TASKS STACK (BOTTOM LEFT - Anchored flush to bottom-left edge, Grows Upwards) -->
    <LinearLayout
        android:id="@+id/dock_bottom_left_container"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_glass_dock_rail"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@id/dock_bottom_container"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUNNING"
            android:textColor="@color/cyan_accent"
            android:textSize="8sp"
            android:textStyle="bold"
            android:paddingBottom="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dock_bottom_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dock_tile" />
    </LinearLayout>

    <!-- BOTTOM MAIN DOCK (Horizontal Glass Dock - Anchored flush to bottom) -->
    <LinearLayout
        android:id="@+id/dock_bottom_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_glass_dock_rail"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dock_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_dock_tile" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
