<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_container"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_margin="2dp"
    android:background="@drawable/bg_frosted_glass_tile_base"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="3dp">

        <!-- Real Application Graphic Icon (Compact default 36dp) -->
        <ImageView
            android:id="@+id/iv_tile_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Text / Emoji Icon Symbol Fallback -->
        <TextView
            android:id="@+id/tv_tile_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📎"
            android:textSize="26sp"
            android:includeFontPadding="false" />

        <!-- Dock Item Title (Bold Format) -->
        <TextView
            android:id="@+id/tv_tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Workspace 1"
            android:textColor="@color/text_primary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Subtle Dock Item Category / Status -->
        <TextView
            android:id="@+id/tv_tile_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="7sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Lower Left Corner Workspace Number Badge -->
    <TextView
        android:id="@+id/tv_tile_workspace_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="2dp"
        android:background="@drawable/bg_glass_dock_rail"
        android:textColor="@color/cyan_accent"
        android:textSize="8sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="1"
        android:visibility="gone" />

</FrameLayout>
