<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Step Launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepLauncher">

        <!-- Main Home Launcher Activity -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.StepLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.StepLauncher" />

        <!-- Broadcast Receiver for External DockApps -->
        <receiver
            android:name=".DockAppReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.steplauncher.action.REGISTER_DOCKAPP" />
            </intent-filter>
        </receiver>

        <!-- Standalone AppWidgetProvider Registration -->
        <receiver
            android:name="com.steplauncher.widget.StepLauncherWidgetProvider"
            android:exported="true"
            android:label="StepLauncher Dock Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/step_launcher_widget_info" />
        </receiver>
    </application>

</manifest>
