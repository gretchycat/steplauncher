<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ Dock &amp; Theme Configuration"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_settings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕ Close"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Customize tile accent tint, text accent, image graphic colors, attention alerts, and telemetry thresholds using RGB/HSV color pickers."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Icon Size Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Tile Icon Size Configuration"
                    android:textColor="@color/cyan_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_icon_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Current Icon Size: 38dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_28"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="28dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_40"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="38dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_56"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="48dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_size_72"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="64dp"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="@color/cyan_accent" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: RGB / HSV Color Customization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎨 Theme Accent Colors (RGB/HSV Pickers)"
                    android:textColor="@color/amber_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 1. Background Accent Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_accent_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🎨 Tile Background Accent: #FFFFFF"
                    android:textColor="#FFFFFF"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FFFFFF" />

                <!-- 2. Text Accent Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_text_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="✍️ Text Accent Color: #FFFFFF"
                    android:textColor="#FFFFFF"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FFFFFF" />

                <!-- 3. Image Accent Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_graphic_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🖼️ Image / Vector Accent Color: #00E5FF"
                    android:textColor="#00E5FF"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#00E5FF" />

                <!-- 4. Attention Alert Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_attention_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🚨 Attention Alert Tint: #FF3D00"
                    android:textColor="#FF3D00"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FF3D00" />

                <!-- 5. Badge Background Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_badge_bg_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🔴 Notification Badge Background: #FF1744"
                    android:textColor="#FF1744"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FF1744" />

                <!-- 6. Badge Text Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_badge_text_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🔤 Notification Badge Text: #FFFFFF"
                    android:textColor="#FFFFFF"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FFFFFF" />

            </LinearLayout>

            <!-- Section 3: Telemetry Threshold Colors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Telemetry &amp; Meter Threshold Colors"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- High Threshold Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_high_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔴 High Threshold Alert Color: #FF5252"
                    android:textColor="#FF5252"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FF5252" />

                <!-- Medium Threshold Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_med_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🟡 Medium Threshold Color: #FFD700"
                    android:textColor="#FFD700"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#FFD700" />

                <!-- Low Threshold Color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_low_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🟢 Low Threshold Normal Color: #00E676"
                    android:textColor="#00E676"
                    android:gravity="start|center_vertical"
                    app:strokeColor="#00E676" />

            </LinearLayout>

            <!-- Section 4: Quick Preset Palettes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_center_canvas"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Quick Preset Theme Palettes"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_cyber"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Cyber"
                        android:textSize="9sp"
                        android:textColor="#00E5FF"
                        app:strokeColor="#00E5FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_matrix"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🟢 Matrix"
                        android:textSize="9sp"
                        android:textColor="#00E676"
                        app:strokeColor="#00E676" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_sunset"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🌅 Sunset"
                        android:textSize="9sp"
                        android:textColor="#FF9100"
                        app:strokeColor="#FF9100" />

                </LinearLayout>
            </LinearLayout>

            <!-- Section 5: Reset Defaults -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Reset Dock Defaults"
                android:textColor="#FFFFFF"
                app:backgroundTint="#44768396"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
